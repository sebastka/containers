{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Only Renovate's built-in presets: the shared home-operations/renovate-config this used to
  // extend was deleted upstream, which stopped every run. The policy it supplied is below.
  // :disableRateLimiting, as every update here is its own PR.
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  // The existing dashboard issue (#2) is found by its title
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  timezone: "Europe/Oslo",
  reviewers: [],
  reviewersFromCodeOwners: false,
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process git-refs Digest Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n.+ = "(?<currentDigest>[^"]+)"',
      ],
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  customDatasources: {
    // ISC tags releases on GitHub before publishing the matching Alpine
    // packages, so tracking github-tags proposes versions that cannot install.
    // This reads what is actually available from the Cloudsmith repository.
    stork: {
      defaultRegistryUrlTemplate: "https://api.cloudsmith.io/v1/packages/isc/stork/?query=name:{{packageName}}+distribution:alpine&page_size=100",
      format: "json",
      transformTemplates: ['{"releases": $distinct($[name="{{packageName}}"].{"version": version})}'],
    },
  },
  packageRules: [
    // Commit messages, labels and groups. A later rule overrides an earlier one, so the app rules
    // further down replace the type and scope for apps/.
    {
      description: ["Commit Messages"],
      matchPackageNames: ["*"],
      semanticCommitType: "chore",
    },
    {
      matchUpdateTypes: ["major", "minor", "patch"],
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      commitMessageExtra: "({{currentDigestShort}} → {{newDigestShort}})",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchManagers: ["gomod"],
      semanticCommitScope: "go",
      commitMessageTopic: "module {{depName}}",
    },
    {
      description: ["Update Type Labels"],
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest", "pinDigest"],
      labels: ["type/digest"],
    },
    {
      // zer0ver: a 0.x minor can break at any time. Label it as a major and put it on its own
      // major- branch, out of the group PRs below. Must come after the plain minor label.
      description: ["Treat 0.x Minor Updates as Major"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      labels: ["type/major"],
      additionalBranchPrefix: "major-",
    },
    {
      description: ["GitHub Actions Group"],
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      // Toolchains after the catch-all, so their groupName wins
      description: ["Mise Tools Group"],
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: ["Go Toolchain Group"],
      matchManagers: ["mise"],
      matchDepNames: ["go"],
      groupName: "Go toolchain",
      groupSlug: "go-toolchain",
    },
    {
      description: ["Node Toolchain Group"],
      matchManagers: ["mise"],
      matchDepNames: ["node"],
      groupName: "Node toolchain",
      groupSlug: "node-toolchain",
    },
    {
      description: ["Strip the apk build suffix from Cloudsmith stork versions"],
      matchDatasources: ["custom.stork"],
      extractVersion: "^(?<version>\\d+\\.\\d+\\.\\d+)\\.",
    },
    {
      description: ["Release Rules for App Updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      description: ["Digest Rules for App Updates"],
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      matchUpdateTypes: ["digest", "pinDigest"],
      commitMessageExtra: "( {{currentDigestShort}} → {{newDigestShort}} )",
    },
    {
      description: ["Pin Digests for Dockerfile Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      pinDigests: true,
    },
    {
      description: ["Auto-merge App Updates"],
      matchFileNames: ["**/docker-bake.hcl"],
      automerge: true,
      automergeType: "pr",
    },
    {
      // matchManagers, not matchDatasources: the github-actions manager emits
      // github-tags / github-digest datasources, so no datasource is named
      // github-actions and a matchDatasources rule here never matches anything.
      // Majors stay manual: new major action releases can change inputs or
      // runtimes.
      description: ["Auto-merge GitHub Actions Updates"],
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "minor", "digest", "pinDigest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: ["Auto-merge All Minor and Digest Updates"],
      matchUpdateTypes: ["minor", "digest", "pinDigest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      // A 0.x minor is treated as a major (see above): keep those out of the
      // blanket rule above so they still get looked at by hand.
      description: ["Do Not Auto-merge 0.x Minor Updates"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
    },
    {
      description: ["Auto-merge Selected Dockerfile Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: [
        "docker.io/library/alpine",
        "docker.io/library/debian"
      ],
      matchUpdateTypes: ["digest", "pinDigest", "patch", "minor", "major"],
      automerge: true,
      automergeType: "pr",
    },
    {
      // Paperless installs upstream's uv.lock as is, and it pins hiredis 3.3.0, which has no
      // cp315 wheel; its sdist's setup.py calls SourceFileLoader.load_module, removed in Python
      // 3.15 (#213). Lift this once paperless-ngx's lock moves to hiredis >= 3.5.0.
      description: ["Hold Paperless on Python 3.14"],
      matchDatasources: ["docker"],
      matchFileNames: ["apps/paperless/Dockerfile"],
      matchPackageNames: ["dhi.io/python"],
      allowedVersions: "/^3\\.14\\./",
    },
  ],
  // apps/deluge/requirements.txt is compiled by uv and pinned with hashes. The pip_requirements
  // manager rewrites a version in place but writes the new hashes out as a second entry, under the
  // name PyPI registers rather than the normalised one uv writes, leaving the first entry on the
  // old hashes; pip then fails --require-hashes (#144). apps/deluge/scripts/update-downloads.py
  // recompiles the file nightly instead, which is also how its transitive dependencies move, and
  // it keeps the Deluge pin in step with docker-bake.hcl. setuptools<81 lives in requirements.in.
  pip_requirements: {
    enabled: false,
  },
}
